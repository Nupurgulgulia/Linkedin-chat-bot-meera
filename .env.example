# Copy this file to .env and fill in the values. Never commit .env.

# From @BotFather on Telegram (/newbot).
TELEGRAM_BOT_TOKEN=

# From https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Any Gemini model that supports JSON output and audio input.
GEMINI_MODEL=gemini-3.6-flash

# Comma-separated Telegram user IDs allowed to use the bot (Meera, and you for testing).
# Send /start to the bot to see your ID. Leave empty to allow anyone (not recommended).
ALLOWED_TELEGRAM_USER_IDS=
